{
    "version": 6,
    "configurePresets": [
        {
            "name": "config",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "config",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "configurePreset": "config",
            "configuration": "Release"
        }
    ]
}
